---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/links';
---

<BaseLayout title="Page not found">
  <Container size="narrow" class="py-24 text-center">
    <p class="font-serif text-7xl font-semibold text-primary">404</p>
    <h1 class="mt-4 text-3xl font-semibold text-fg">This page isn't on the record</h1>
    <p class="mt-3 text-muted">The link may be old, or the page may have moved.</p>
    <a
      href={url('/')}
      class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-full bg-primary px-5 font-semibold text-primary-fg shadow-card transition hover:-translate-y-0.5 hover:shadow-lift"
    >
      Back to home <Icon name="arrow-right" size={18} />
    </a>
  </Container>
</BaseLayout>
