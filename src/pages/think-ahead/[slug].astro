---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Icon from '../../components/Icon.astro';
import SaveToNotes from '../../components/SaveToNotes.astro';
import Tag from '../../components/Tag.astro';
import { url } from '../../lib/links';

export const getStaticPaths = (async () => {
  const entries = await getCollection('trends');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const lastReviewedFmt = new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }).format(entry.data.lastReviewed);
const sectionLabel = entry.data.section === 'trend-brief' ? 'Trend brief' : 'Career path';
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <Container size="narrow" class="animate-rise pb-16 pt-10 sm:pt-14">
    <a href={url('/think-ahead')} class="inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-muted hover:text-fg">
      <Icon name="arrow-right" size={16} class="rotate-180" />
      Back to Think Ahead
    </a>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <Tag color={entry.data.section === 'trend-brief' ? 5 : 2}>{sectionLabel}</Tag>
    </div>

    <h1 class="mt-3 text-3xl font-semibold leading-tight text-fg sm:text-4xl">{entry.data.title}</h1>
    <p class="mt-3 text-lg leading-relaxed text-muted">{entry.data.summary}</p>

    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted">
      <span class="flex items-center gap-1.5">
        <Icon name="calendar" size={15} />
        Last reviewed {lastReviewedFmt}
      </span>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <SaveToNotes title={entry.data.title} excerpt={entry.data.summary} url={url(`/think-ahead/${entry.id}`)} tag="think-ahead" />
      <div class="flex flex-wrap gap-1.5">
        {entry.data.tags.map((t) => <Tag color={8}>{t}</Tag>)}
      </div>
    </div>

    {
      entry.data.skillsNeeded.length > 0 && (
        <div class="mt-8 rounded-2xl border border-primary/20 bg-primary-soft p-5">
          <h2 class="flex items-center gap-2 font-semibold text-fg">
            <Icon name="sparkles" size={18} class="text-primary" />
            Skills this path leans on
          </h2>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {entry.data.skillsNeeded.map((s) => <Tag color={1}>{s}</Tag>)}
          </div>
        </div>
      )
    }

    <div class="prose prose-neutral mt-10 max-w-none">
      <Content />
    </div>

    {
      entry.data.sources.length > 0 && (
        <div class="mt-10 rounded-2xl border border-border bg-surface-2 p-5">
          <h2 class="flex items-center gap-2 text-sm font-semibold text-fg">
            <Icon name="book" size={16} />
            Sources
          </h2>
          <ul class="mt-3 grid gap-1.5 text-sm">
            {entry.data.sources.map((s) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                  {s.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </Container>
</BaseLayout>
