---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Card from '../../components/Card.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Tag from '../../components/Tag.astro';
import { navItem } from '../../data/nav';
import { learnCategories } from '../../data/taxonomy';

const page = navItem('/learn');
---

<BaseLayout title={page.label} description={page.description}>
  <PageHeader eyebrow="Library" icon={page.icon} title="Learn the law behind the deals" description={page.description} />

  <Container>
    <section aria-labelledby="categories-heading">
      <SectionHeading id="categories-heading" title="Categories" description="Topics will be filed under these areas." />
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          learnCategories.map((c) => (
            <li>
              <Card class="h-full">
                <Tag color={c.color}>{c.label}</Tag>
                <p class="mt-3 text-sm leading-relaxed text-muted">{c.description}</p>
              </Card>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-12">
      <ComingSoon
        phase={3}
        items={[
          'Around 10 in-depth topics on investment and startup law to begin with',
          'Filter by category, level and tags',
          'Key-takeaways box and related topics on every page',
          '"Mark as read", tracked in your progress',
          'Primary sources cited, with a last-reviewed date',
          'Links to matching practice exercises',
        ]}
      />
    </section>
  </Container>
</BaseLayout>
