---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import LearnExplorer from '../../components/LearnExplorer.astro';
import PageHeader from '../../components/PageHeader.astro';
import { navItem } from '../../data/nav';

const page = navItem('/learn');
const topics = (await getCollection('learn')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={page.label} description={page.description}>
  <PageHeader eyebrow="Library" icon={page.icon} title="Learn the law behind the deals" description={page.description} />

  <Container>
    {
      topics.length > 0 ? (
        <LearnExplorer topics={topics} />
      ) : (
        <div class="rounded-2xl border border-dashed border-border bg-surface/60 p-8 text-center text-muted">
          Topics are on their way — check back soon.
        </div>
      )
    }

    <section class="mt-12">
      <ComingSoon
        phase={3}
        title="Still to come"
        items={[
          'Growing toward the full category list in the roadmap',
          '"Mark as read" streak/progress already wired up above — try it on a topic page',
          'A quiz/flashcard exercise linked from each topic (Phase 4)',
          'Pagefind full-text search across every topic (Phase 7)',
        ]}
      />
    </section>
  </Container>
</BaseLayout>
