---
/**
 * Shown by the service worker (public/sw.js) when a page is requested
 * while offline and isn't already cached. Precached on install so it's
 * always available.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/links';
---

<BaseLayout title="You're offline">
  <Container size="narrow" class="py-24 text-center">
    <p class="font-serif text-6xl font-semibold text-primary">Offline</p>
    <h1 class="mt-4 text-3xl font-semibold text-fg">This page isn't saved for offline reading</h1>
    <p class="mt-3 text-muted">Pages you've already visited are available offline. Reconnect and revisit a page once to save it.</p>
    <a
      href={url('/')}
      class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-full bg-primary px-5 font-semibold text-primary-fg shadow-card transition hover:-translate-y-0.5 hover:shadow-lift"
    >
      Back to home <Icon name="arrow-right" size={18} />
    </a>
  </Container>
</BaseLayout>
