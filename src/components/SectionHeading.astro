---
/** Heading row for a section inside a page, with an optional "see all" link. */
import Icon from './Icon.astro';

interface Props {
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  id?: string;
}
const { title, description, href, linkLabel = 'See all', id } = Astro.props;
---

<div class="mb-5 flex items-end justify-between gap-4">
  <div>
    <h2 id={id} class="text-2xl font-semibold text-fg sm:text-[1.7rem]">{title}</h2>
    {description && <p class="mt-1 text-muted">{description}</p>}
  </div>
  {
    href && (
      <a
        href={href}
        class="group inline-flex min-h-11 shrink-0 items-center gap-1.5 text-sm font-semibold text-primary hover:text-primary-strong"
      >
        {linkLabel}
        <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-0.5" />
      </a>
    )
  }
</div>
