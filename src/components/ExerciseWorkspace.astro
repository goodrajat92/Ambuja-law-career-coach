---
/**
 * The interactive part of an exercise page: a writing area (autosaved),
 * an optional timer, a self-assessment rubric, and a model answer that
 * stays hidden until revealed — then a self-score that's saved to
 * progress (src/lib/progress.ts), which the streak widget reads.
 */
import Icon from './Icon.astro';

interface Props {
  slug: string;
  rubric: string[];
  modelAnswer: string[];
}
const { slug, rubric, modelAnswer } = Astro.props;
---

<div data-exercise={slug} class="grid gap-6 lg:grid-cols-5">
  <div class="lg:col-span-3">
    <div class="flex items-center justify-between gap-3">
      <h2 class="flex items-center gap-2 font-semibold text-fg">
        <Icon name="pen" size={18} class="text-primary" />
        Your answer
      </h2>
      <div class="flex items-center gap-2 text-sm text-muted">
        <span data-timer-display class="tabular-nums">00:00</span>
        <button type="button" data-timer-toggle class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-border bg-surface px-3 text-xs font-semibold hover:bg-surface-2">
          <Icon name="clock" size={14} />
          <span data-timer-label>Start timer</span>
        </button>
      </div>
    </div>
    <textarea
      data-exercise-draft
      rows="14"
      placeholder="Write your answer here — it's saved automatically on this device as you type."
      class="mt-3 w-full resize-y rounded-2xl border border-border bg-surface p-4 font-sans text-sm leading-relaxed text-fg shadow-card placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-primary/40"
    ></textarea>
    <p data-save-indicator class="mt-1.5 h-4 text-xs text-muted"></p>
  </div>

  <div class="lg:col-span-2">
    <h2 class="flex items-center gap-2 font-semibold text-fg">
      <Icon name="check" size={18} class="text-primary" />
      Self-assessment
    </h2>
    <ul class="mt-3 grid gap-2">
      {
        rubric.map((item, i) => (
          <li>
            <label class="flex min-h-11 cursor-pointer items-start gap-2.5 rounded-xl border border-border bg-surface p-3 text-sm leading-relaxed text-fg shadow-card has-[:checked]:border-success/40 has-[:checked]:bg-success/5">
              <input type="checkbox" data-rubric-check={i} class="mt-0.5 size-4 shrink-0 accent-[var(--success)]" />
              <span>{item}</span>
            </label>
          </li>
        ))
      }
    </ul>

    <div class="mt-5">
      <button
        type="button"
        data-reveal-answer
        class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl border border-primary/30 bg-primary-soft px-4 text-sm font-semibold text-primary transition hover:-translate-y-0.5 hover:shadow-card"
      >
        <Icon name="sparkles" size={16} />
        Show model answer
      </button>

      <div data-model-answer class="mt-4 hidden">
        <div class="rounded-2xl border border-border bg-surface-2 p-4">
          <p class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wide text-muted">
            <Icon name="book" size={14} />
            Model answer
          </p>
          <div class="prose prose-sm mt-2 max-w-none">
            {modelAnswer.map((p) => <p>{p}</p>)}
          </div>
        </div>

        <div class="mt-4 rounded-2xl border border-border bg-surface p-4 shadow-card">
          <p class="text-sm font-semibold text-fg">How did your answer compare?</p>
          <div class="mt-2.5 grid grid-cols-3 gap-2">
            <button type="button" data-score="1" class="min-h-11 rounded-lg border border-border px-2 text-xs font-medium hover:bg-surface-2">
              Needs work
            </button>
            <button type="button" data-score="2" class="min-h-11 rounded-lg border border-border px-2 text-xs font-medium hover:bg-surface-2">
              Good attempt
            </button>
            <button type="button" data-score="3" class="min-h-11 rounded-lg border border-border px-2 text-xs font-medium hover:bg-surface-2">
              Nailed it
            </button>
          </div>
          <p data-score-confirm class="mt-2.5 hidden items-center gap-1.5 text-sm font-medium text-success">
            <Icon name="check" size={16} />
            Saved to your progress.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { markExerciseDone, readExerciseState, writeExerciseState } from '../lib/progress';

  document.querySelectorAll<HTMLElement>('[data-exercise]').forEach((root) => {
    const slug = root.dataset.exercise!;
    const state = readExerciseState(slug);

    // --- Draft (autosaved) ---
    const draft = root.querySelector<HTMLTextAreaElement>('[data-exercise-draft]')!;
    const saveIndicator = root.querySelector<HTMLElement>('[data-save-indicator]')!;
    draft.value = state.draft;
    let saveTimer: ReturnType<typeof setTimeout>;
    draft.addEventListener('input', () => {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(() => {
        state.draft = draft.value;
        writeExerciseState(slug, state);
        saveIndicator.textContent = 'Saved on this device';
        clearTimeout((saveIndicator as any)._fade);
        (saveIndicator as any)._fade = setTimeout(() => (saveIndicator.textContent = ''), 2000);
      }, 500);
    });

    // --- Rubric checklist (saved) ---
    const checks = [...root.querySelectorAll<HTMLInputElement>('[data-rubric-check]')];
    checks.forEach((cb, i) => {
      cb.checked = !!state.checked[i];
      cb.addEventListener('change', () => {
        state.checked[i] = cb.checked;
        writeExerciseState(slug, state);
      });
    });

    // --- Timer (stopwatch; not persisted across reloads) ---
    const timerDisplay = root.querySelector<HTMLElement>('[data-timer-display]')!;
    const timerToggle = root.querySelector<HTMLButtonElement>('[data-timer-toggle]')!;
    const timerLabel = root.querySelector<HTMLElement>('[data-timer-label]')!;
    let seconds = 0;
    let interval: ReturnType<typeof setInterval> | null = null;
    timerToggle.addEventListener('click', () => {
      if (interval) {
        clearInterval(interval);
        interval = null;
        timerLabel.textContent = 'Resume timer';
      } else {
        timerLabel.textContent = 'Pause timer';
        interval = setInterval(() => {
          seconds++;
          const m = String(Math.floor(seconds / 60)).padStart(2, '0');
          const s = String(seconds % 60).padStart(2, '0');
          timerDisplay.textContent = `${m}:${s}`;
        }, 1000);
      }
    });

    // --- Reveal model answer + self-score ---
    const revealBtn = root.querySelector<HTMLButtonElement>('[data-reveal-answer]')!;
    const answerBox = root.querySelector<HTMLElement>('[data-model-answer]')!;
    revealBtn.addEventListener('click', () => {
      answerBox.classList.remove('hidden');
      revealBtn.classList.add('hidden');
      answerBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-score]').forEach((btn) => {
      btn.addEventListener('click', () => {
        markExerciseDone(slug);
        root.querySelectorAll('[data-score]').forEach((b) => b.classList.remove('!border-primary', '!bg-primary-soft', '!text-primary'));
        btn.classList.add('!border-primary', '!bg-primary-soft', '!text-primary');
        root.querySelector('[data-score-confirm]')!.classList.remove('hidden');
        root.querySelector('[data-score-confirm]')!.classList.add('flex');
      });
    });
  });
</script>
