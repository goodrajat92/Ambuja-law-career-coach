---
/** Brand mark + wordmark, linking home. */
import Icon from './Icon.astro';
import { site } from '../data/site';
import { url } from '../lib/links';
---

<a href={url('/')} class="group inline-flex min-h-11 items-center gap-2.5 rounded-xl pr-2" aria-label={`${site.name}, home`}>
  <span
    class="relative grid size-9 place-items-center rounded-xl bg-primary text-primary-fg shadow-card transition group-hover:rotate-[-4deg]"
  >
    <Icon name="scale" size={19} strokeWidth={2} />
    <span class="absolute -right-0.5 -top-0.5 size-2.5 rounded-full bg-accent-solid ring-2 ring-bg"></span>
  </span>
  <span class="font-serif text-lg font-semibold tracking-tight text-fg">{site.name}</span>
</a>
