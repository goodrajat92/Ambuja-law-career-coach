---
/**
 * Small colored pill for categories and tags. `color` selects one of the
 * category tokens (--cat-1 ... --cat-8); the background is a soft tint of
 * the same token, so it works in both themes.
 */
import type { CatColor } from '../data/taxonomy';

interface Props {
  color?: CatColor;
  class?: string;
}
const { color = 8, class: className } = Astro.props;
const style = `color: var(--cat-${color}); background-color: color-mix(in oklab, var(--cat-${color}) 12%, transparent); border-color: color-mix(in oklab, var(--cat-${color}) 22%, transparent);`;
---

<span class:list={['inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium', className]} style={style}>
  <slot />
</span>
