---
import Container from './Container.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<footer class="mt-20 border-t border-border">
  <Container class="flex flex-col gap-3 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="flex items-center gap-2">
      <Icon name="scale" size={16} />
      <span>{site.disclaimer}</span>
    </p>
    <p class="flex items-center gap-2">
      <Icon name="lock" size={16} />
      <span>Your notes and progress stay on this device.</span>
    </p>
  </Container>
</footer>
