---
/**
 * Placeholder panel for sections that are planned but not built yet.
 * Lists what is coming, so each placeholder page doubles as a roadmap.
 */
import Icon from './Icon.astro';

interface Props {
  phase: number;
  title?: string;
  items: string[];
}
const { phase, title = 'What is coming here', items } = Astro.props;
---

<div class="relative overflow-hidden rounded-2xl border border-dashed border-border bg-surface/60 p-6 sm:p-8">
  <div class="flex flex-wrap items-center gap-3">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">
      <Icon name="sparkles" size={14} strokeWidth={2} />
      Phase {phase}
    </span>
    <h2 class="text-xl font-semibold text-fg">{title}</h2>
  </div>
  <ul class="mt-5 grid gap-3 sm:grid-cols-2">
    {
      items.map((item) => (
        <li class="flex gap-3 text-muted">
          <Icon name="check" size={18} class="mt-0.5 shrink-0 text-primary" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
  <slot />
</div>
