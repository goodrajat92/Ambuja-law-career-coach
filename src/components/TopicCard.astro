---
/** A Learn topic card for the listing page. */
import Card from './Card.astro';
import Icon from './Icon.astro';
import Tag from './Tag.astro';
import { learnCategories } from '../data/taxonomy';
import { url } from '../lib/links';
import type { CollectionEntry } from 'astro:content';

interface Props {
  topic: CollectionEntry<'learn'>;
}
const { topic } = Astro.props;
const category = learnCategories.find((c) => c.slug === topic.data.category);

const levelStyle = {
  beginner: 'text-success',
  intermediate: 'text-accent',
  advanced: 'text-primary',
} as const;
---

<Card
  href={url(`/learn/${topic.id}`)}
  class="flex h-full flex-col"
  data-topic-card
  data-category={topic.data.category}
  data-level={topic.data.level}
  data-tags={topic.data.tags.join(',')}
  data-search={`${topic.data.title} ${topic.data.summary}`.toLowerCase()}
>
  <div class="flex flex-wrap items-center gap-2">
    {category && <Tag color={category.color}>{category.label}</Tag>}
    <span class:list={['inline-flex items-center gap-1 text-xs font-semibold capitalize', levelStyle[topic.data.level]]}>
      <Icon name="target" size={12} strokeWidth={2.2} />
      {topic.data.level}
    </span>
  </div>
  <h2 class="mt-3 font-serif text-lg font-semibold leading-snug text-fg">{topic.data.title}</h2>
  <p class="mt-1.5 flex-1 text-sm leading-relaxed text-muted">{topic.data.summary}</p>
  <div class="mt-4 flex items-center justify-between border-t border-border pt-3 text-xs text-muted">
    <span class="flex items-center gap-1.5">
      <Icon name="clock" size={14} />
      {topic.data.readingTime} min read
    </span>
    <span class="inline-flex items-center gap-1.5 font-semibold text-primary">
      Read <Icon name="arrow-right" size={14} class="transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</Card>
