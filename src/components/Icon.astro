---
/**
 * Inline SVG icon set (stroke icons in the style of Lucide, 24x24 grid).
 * Inline SVGs need no extra dependency or network request and take the
 * current text color. Add an icon = add one entry in src/lib/icons.ts.
 *
 * Decorative by default (aria-hidden). Pass `label` when the icon is the
 * only content of a control, so screen readers get a name.
 */
import { icons, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className, label, strokeWidth = 1.75, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={icons[name]}
  {...rest}
></svg>
