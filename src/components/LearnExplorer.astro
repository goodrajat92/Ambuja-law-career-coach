---
/** Client-side filterable grid of Learn topics: category, level, tag, search. */
import Icon from './Icon.astro';
import TopicCard from './TopicCard.astro';
import { learnCategories } from '../data/taxonomy';
import type { CollectionEntry } from 'astro:content';

interface Props {
  topics: CollectionEntry<'learn'>[];
}
const { topics } = Astro.props;
const usedCategories = learnCategories.filter((c) => topics.some((t) => t.data.category === c.slug));
const allTags = [...new Set(topics.flatMap((t) => t.data.tags))].sort();
---

<div data-learn-explorer>
  <div data-pagefind-ignore class="flex flex-wrap items-center gap-3 rounded-2xl border border-border bg-surface p-4 shadow-card">
    <label class="flex w-full min-w-0 items-center gap-2 rounded-xl border border-border bg-surface-2 px-3 py-2 sm:w-auto sm:min-w-[14rem] sm:flex-1">
      <Icon name="book" size={16} class="shrink-0 text-muted" />
      <span class="sr-only">Search topics</span>
      <input type="search" data-filter="search" placeholder="Search topics..." class="w-full min-w-0 bg-transparent text-sm text-fg placeholder:text-muted focus:outline-none" />
    </label>

    <select data-filter="category" aria-label="Filter by category" class="min-h-11 rounded-xl border border-border bg-surface-2 px-3 text-sm text-fg">
      <option value="">All categories</option>
      {usedCategories.map((c) => <option value={c.slug}>{c.label}</option>)}
    </select>

    <select data-filter="level" aria-label="Filter by level" class="min-h-11 rounded-xl border border-border bg-surface-2 px-3 text-sm text-fg">
      <option value="">All levels</option>
      <option value="beginner">Beginner</option>
      <option value="intermediate">Intermediate</option>
      <option value="advanced">Advanced</option>
    </select>

    <select data-filter="tag" aria-label="Filter by tag" class="min-h-11 rounded-xl border border-border bg-surface-2 px-3 text-sm text-fg">
      <option value="">All tags</option>
      {allTags.map((t) => <option value={t}>{t}</option>)}
    </select>

    <button type="button" data-clear-filters class="ml-auto inline-flex min-h-11 items-center gap-1.5 rounded-xl px-3 text-sm font-medium text-muted hover:bg-surface-2 hover:text-fg">
      Clear filters
    </button>
  </div>

  <p data-topic-count class="mt-4 text-sm text-muted"></p>

  <ul class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {topics.map((topic) => <li class="min-w-0"><TopicCard topic={topic} /></li>)}
  </ul>

  <p data-topic-empty class="hidden rounded-2xl border border-dashed border-border bg-surface/60 p-8 text-center text-muted">
    No topics match these filters yet.
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-learn-explorer]');
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-topic-card]')];
    const countEl = root.querySelector('[data-topic-count]')!;
    const emptyEl = root.querySelector('[data-topic-empty]')!;
    const filters = {
      search: root.querySelector<HTMLInputElement>('[data-filter="search"]')!,
      category: root.querySelector<HTMLSelectElement>('[data-filter="category"]')!,
      level: root.querySelector<HTMLSelectElement>('[data-filter="level"]')!,
      tag: root.querySelector<HTMLSelectElement>('[data-filter="tag"]')!,
    };

    function apply() {
      const q = filters.search.value.trim().toLowerCase();
      const category = filters.category.value;
      const level = filters.level.value;
      const tag = filters.tag.value;
      let visible = 0;
      for (const card of cards) {
        const li = card.closest('li')!;
        const tags = card.dataset.tags?.split(',') ?? [];
        const matches =
          (!category || card.dataset.category === category) &&
          (!level || card.dataset.level === level) &&
          (!tag || tags.includes(tag)) &&
          (!q || card.dataset.search!.includes(q));
        li.classList.toggle('hidden', !matches);
        if (matches) visible++;
      }
      countEl.textContent = `Showing ${visible} of ${cards.length} ${cards.length === 1 ? 'topic' : 'topics'}`;
      emptyEl.classList.toggle('hidden', visible > 0);
    }

    Object.values(filters).forEach((el) => el.addEventListener('input', apply));
    root.querySelector('[data-clear-filters]')!.addEventListener('click', () => {
      filters.search.value = '';
      filters.category.value = '';
      filters.level.value = '';
      filters.tag.value = '';
      apply();
    });

    apply();
  }
</script>
